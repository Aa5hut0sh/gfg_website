datasource db {
  provider = "postgresql" // or "mongodb" / "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  EXECUTIVE
  ADMIN
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model User {
  id            String     @id @default(uuid())
  name          String
  email         String     @unique
  role          Role       @default(USER)
  assignedTasks Task[]     @relation("AssignedTasks")
  createdTasks  Task[]     @relation("CreatedTasks")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  assignedToId String
  assignedTo  User       @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User       @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}